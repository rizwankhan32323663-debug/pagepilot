# PagePilot environment variables — NAMES ONLY, no real values.
# Copy to .env and fill in. NEVER commit .env to git.

# --- Supabase (Phase 2) — safe to expose in the browser build ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase service role (SERVER ONLY — Edge Functions / scheduler) ---
# Never prefix with VITE_. Never put in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta app (Phase 3 — SERVER ONLY) ---
META_APP_ID=
META_APP_SECRET=
# Public URL of this app, e.g. https://pagepilot.example.com
APP_URL=
# Must exactly match the redirect URI registered in the Meta app dashboard:
#   {SUPABASE_URL}/functions/v1/oauth-callback
# (SUPABASE_URL = your project's URL, same value as VITE_SUPABASE_URL)
META_REDIRECT_URI=

# --- Token encryption (Phase 3 — SERVER ONLY, REQUIRED) ---
# AES-256-GCM key for encrypting Meta tokens at rest in Postgres.
# REQUIRED by all token-handling Edge Functions (oauth-callback, token-import,
# pages-list, page-validate, publish-worker). Functions fail loudly without it.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
